<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F0C"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="SAVED VIDEOS"
        android:textColor="#4CAF50"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Tap a clip to Play, Save to Pictures, or Delete."
        android:textColor="#90A4AE"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:text="No clips yet. They appear after the camera detects motion or sound."
        android:textColor="#607D8B"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/clips_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
